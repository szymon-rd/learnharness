{$LH_HOST} {
	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type image/svg+xml*
		}
	}

	# Lean code cells (the code-cells plugin): the language-server WebSocket,
	# for paired devices only. The check is any cheap read-only API route:
	# the app answers it only for a paired device (others get its 401).
	handle /lean/lsp {
		forward_auth learnharness:3210 {
			uri /api/themes
			# The check is a plain GET, not a WebSocket upgrade.
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy lean:3300
	}

	# Rocq code cells: the same for the coq-lsp WebSocket.
	handle /rocq/lsp {
		forward_auth learnharness:3210 {
			uri /api/themes
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy rocq:3600
	}

	handle {
		reverse_proxy learnharness:3210
	}
}
