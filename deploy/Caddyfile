{$LH_HOST} {
	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type image/svg+xml*
		}
	}

	# Lean code cells: the language-server WebSocket, for paired devices only
	# (the app answers the check; an unpaired device gets its 401).
	handle /lean/lsp {
		forward_auth learnharness:3210 {
			uri /api/lean/authorize
			# The check is a plain GET, not a WebSocket upgrade.
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy lean:3300
	}

	handle {
		reverse_proxy learnharness:3210
	}
}
