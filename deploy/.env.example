# The hostname the phone connects to. It must point at this server.
#  - Your own domain: lh.example.com (create a DNS A record to this server's IP)
#  - No domain: <server IP with dashes or dots>.sslip.io, e.g. 203.0.113.7.sslip.io
LH_HOST=203.0.113.7.sslip.io

# Lean code cells (optional): memory cap for the Lean container and how many
# language servers may run at once (each needs about 1.5 GB with Mathlib).
# LEAN_MEM_LIMIT=3g
# LEAN_MAX_SESSIONS=1
